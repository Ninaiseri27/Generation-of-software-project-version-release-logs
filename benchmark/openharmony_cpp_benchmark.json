{
  "benchmark": "openharmony-cpp-release-note-benchmark-v1",
  "created_at": "2026-04-30",
  "goal": "Expand the graduation-project benchmark beyond one repository while keeping version-pair selection reproducible.",
  "methodology": {
    "source": "Five-layer benchmark design adapted from release-note generation literature such as VerLog.",
    "layers": [
      "candidate_repository_pool",
      "version_pair_screening",
      "ground_truth_admission",
      "experiment_stratification",
      "unified_evaluation"
    ],
    "case_root": "benchmark/cases",
    "case_schema": "benchmark/case_schema.md"
  },
  "selection_criteria": [
    "OpenHarmony ecosystem repository",
    "C/C++ dominant third-party or native component",
    "public release tags are available",
    "adjacent version pairs can be compared without building the project",
    "static analysis can run on source snapshots"
  ],
  "admission_policy": [
    "A version pair can be screened before it becomes part of the final evaluation set.",
    "core_eval admission requires reviewed ground truth, not only runnable pipeline outputs.",
    "patch-only cases are retained as patch_challenge cases but excluded from core_eval until patch-aware extraction is implemented.",
    "All admitted core_eval cases should support the same baseline and ablation variants."
  ],
