{
  "git_executable": "git",
  "version_pair": {
    "repo_path": "workspaces/third_party_curl",
    "ref_version": "OpenHarmony-v6.0-Release",
    "tgt_version": "OpenHarmony-v6.0.0.1-Release"
  },
  "include_extensions": [
    ".c",
    ".cc",
    ".cpp",
    ".cxx",
    ".h",
    ".hh",
    ".hpp",
    ".hxx"
  ],
  "diff_context_lines": 0,
  "output_dir": "outputs/third_party_curl/OpenHarmony-v6.0-Release__OpenHarmony-v6.0.0.1-Release",
  "project": {
    "name": "third_party_curl",
    "description": "OpenHarmony third-party curl component."
  },
  "generation": {
    "backend": "openai",
    "model_name": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "extra_body": {
      "thinking": {
        "type": "disabled"
      }
    },
    "temperature": 0.2,
    "max_tokens": 4096,
    "timeout_sec": 60,
    "max_retries": 2,
    "retry_backoff_sec": 1.5,
    "aggregation_strategy": "rule_family"
  },
  "enre": {
    "java_executable": "java",
    "enre_jar_path": "tools/ENRE-CPP.jar",
    "max_heap": "8g",
    "snapshot_root": "workspaces/version_snapshots",
    "project_name": "third_party_curl",
    "extra_dirs": [],
    "program_environments": [],
    "raw_output_root": "outputs/enre_raw"
  }
}
